# Адрес API. Укажите IP машины, на которой запущен бэкенд: с телефона
# localhost недоступен, для Android-эмулятора используйте http://10.0.2.2:3000
BASE_URL=http://localhost:3000

# Тот же адрес, но для Socket.IO
SOCKET_URL=http://localhost:3000

# ${BASE_URL} раскрывается flutter_dotenv при загрузке
BASE_URL_API=${BASE_URL}/api
