# Конфигурация продакшн-стека. Скопируйте в .env.prod и заполните.
# .env.prod не попадает в git — см. .gitignore.

# Домен, на котором живёт API. На него Caddy выпустит сертификат,
# и он же пойдёт в BASE_URL/SOCKET_URL при сборке APK.
DOMAIN=api.orbita.ru

# Пароль PostgreSQL. Сгенерировать: openssl rand -hex 24
DB_PASSWORD=

# Подпись JWT, минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Адреса, которым разрешены CORS-запросы (через запятую).
ALLOWED_ORIGINS=https://api.orbita.ru

# Публичный адрес API — нужен для абсолютных ссылок на картинки в push.
PUBLIC_BASE_URL=https://api.orbita.ru

# SMTP для кодов подтверждения (Gmail — пароль приложения, не основной).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Firebase-проект для push. Рядом должен лежать serviceAccountKey.json.
FIREBASE_PROJECT_ID=orbita-messenger-6517f
